{:paths ["src"]
 ;; kotobase-query (kotoba-lang/kotobase-query) is the ADR-2607172300 bridge
 ;; that turns kotobase.store/IStore documents into a queryable
 ;; arrangement-backed Datalog database (kotobase.query.bridge/materialize +
 ;; q). This repo's kotobase.protocols.cypher hand-writes a small v0.1
 ;; openCypher parser + translator that targets that bridge's :find/:where
 ;; shape directly -- it does not reimplement materialization or query
 ;; evaluation.
 ;;
 ;; kotobase-query's own deps.edn pulls in kotobase (kotobase.store/local)
 ;; and arrangement (the 4-covering index + arrangement.datalog); arrangement
 ;; in turn pulls in prolly-tree/io-ipld (its commit!/CID-snapshot machinery,
 ;; unused by this bridge chain but required at namespace-load time), which
 ;; pull in io-multiformats/org-ietf-cbor. tools.deps resolves that whole
 ;; chain transitively from the single direct dep below for the JVM :test
 ;; alias. The nbb primary test path has no dependency resolver, so
 ;; bin/run_tests.cljs / CI clone every transitive dep by hand and list every
 ;; src dir on --classpath -- see the README's Develop/test section for the
 ;; exact command and kotobase-query's own README for why each hop is there.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/ayatori
        {:git/url "https://github.com/kotoba-lang/ayatori.git"
         :git/sha "d50ff2529daf428a5e3b8e43d1ca8ec0d6239c29"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   nbb --classpath "src:test:.deps/kotobase/src:.deps/ayatori/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-nist-sha2/src:.deps/org-ietf-cbor/src:.deps/dev-protobuf/src:.deps/datalog/src:.deps/io-ipni-specs/src" bin/run_tests.cljs
 ;; The :test alias below is the :clj COMPAT suite only -- not the primary
 ;; execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
